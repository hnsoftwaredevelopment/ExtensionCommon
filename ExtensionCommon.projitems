<?xml version="1.0" encoding="utf-8"?>
<!-- The files that every extension compiles in. Keep all types internal: the same type in two extensions must not clash. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>6b70bfac-7595-4c31-af74-62e098385fd2</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>ExtensionCommon</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)VisualStudio\ExtensionSource.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)VisualStudio\InstalledExtensions.cs" />
  </ItemGroup>
</Project>
